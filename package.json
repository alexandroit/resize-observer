{
  "name": "@stackline/resize-observer",
  "version": "1.0.1",
  "description": "Polyfills the ResizeObserver API and supports box size options from the latest spec",
  "type": "commonjs",
  "main": "lib/exports/resize-observer.umd.js",
  "module": "lib/exports/resize-observer.mjs",
  "types": "lib/exports/resize-observer.d.ts",
  "unpkg": "lib/exports/resize-observer.browser.js",
  "jsdelivr": "lib/exports/resize-observer.browser.js",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/exports/resize-observer.d.mts",
        "default": "./lib/exports/resize-observer.mjs"
      },
      "require": {
        "types": "./lib/exports/resize-observer.d.cts",
        "default": "./lib/exports/resize-observer.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf lib docs",
    "build": "npm run clean && npm run build:lib && npm run build:docs",
    "build:lib": "npm run build:esm && npm run build:bundles && npm run build:types",
    "build:esm": "node node_modules/typescript/bin/tsc",
    "build:bundles": "rollup -c",
    "build:types": "node scripts/normalize-declarations.mjs",
    "build:docs": "node scripts/build-docs.mjs --all",
    "build:docs:v1.0.0": "node scripts/build-docs.mjs v1.0.0",
    "build:docs:v1.0.1": "node scripts/build-docs.mjs v1.0.1",
    "build:download": "node scripts/build-download.mjs",
    "build:package": "npm run build",
    "docs:build": "npm run build:docs",
    "pack:check": "node scripts/pack-check.mjs",
    "start": "npm run build:docs && serve docs -l 4173",
    "check": "npm test && npm run build && npm run test:types:legacy && npm run test:package && npm run build:download && npm run pack:check",
    "ci": "npm run check",
    "test": "npm run lint && jest --coverage",
    "test:package": "node scripts/test-package.mjs",
    "test:types:legacy": "node node_modules/typescript-3-9/lib/tsc.js --project tests/typescript-3.9/tsconfig.json",
    "lint": "eslint '{src,test}/**/*.ts'",
    "preversion": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/resize-observer.git"
  },
  "keywords": [
    "resize-observer",
    "polyfill",
    "ponyfill",
    "browser",
    "dom",
    "resize",
    "observer",
    "typescript",
    "javascript",
    "element",
    "element-resize",
    "responsive",
    "web-components",
    "ui",
    "angular",
    "react",
    "vue",
    "maintained"
  ],
  "author": "Alexandro Paixao Marques",
  "contributors": [
    "Juggle (original project)"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/alexandroit/resize-observer/issues"
  },
  "homepage": "https://alexandro.net/docs/vanilla/resize-observer/",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript-eslint": "^8.67.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "rollup": "^4.62.4",
    "serve": "^14.2.5",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-3-9": "npm:typescript@3.9.10"
  }
}
